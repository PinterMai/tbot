# X / Twitter (Step B+)
# Preferred: path to a JSON file with the FULL cookie dict exported from a
# logged-in browser tab (e.g. {"auth_token":"...","ct0":"...","guest_id":"..."}).
# Without ct0, twikit's anti-bot transaction-id flow fails and every fetch errors.
# Fallback: just the auth_token cookie (will likely fail on its own — see README).

# Behavior
DRY_RUN=true
POLL_INTERVAL_MIN=60
TWEET_SOURCE=twikit
LOG_LEVEL=INFO
