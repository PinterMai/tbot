# Force LF line endings everywhere except Windows-only scripts.
* text=auto eol=lf

*.py     text eol=lf
*.md     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.toml   text eol=lf
*.json   text eol=lf
*.txt    text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf

*.bat    text eol=crlf
*.ps1    text eol=crlf
*.cmd    text eol=crlf

*.db     binary
*.png    binary
*.jpg    binary
*.gif    binary
